{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler", 
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "*": ["../../../node_modules/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules", // <--- Explicitly ignore node_modules
    "src/webview"   // <--- We already excluded this for the React fix
  ]
}